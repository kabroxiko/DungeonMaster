# Copy to `.env` in the repository root and fill in values. Never commit real secrets.
# gmai-server loads this file automatically (see go/cmd/gmai-server/main.go).

DM_MONGODB_URI=mongodb://localhost:27017/dungeonmaster
DM_OPENAI_API_KEY=

# Docker Compose only: root credentials and volume for the Mongo service in docker-compose.yml. gmai-server
# ignores these and connects with DM_MONGODB_URI above.
MONGO_ROOT_USER=dungeonmaster
MONGO_ROOT_PASSWORD=change-me
DM_MONGO_DB=dungeonmaster
MONGO_DATA_VOLUME=

# Google Sign-In (Web client ID from Google Cloud Console). The SPA reads it from GET /api/meta at runtime.
# In Console, Authorized JavaScript origins must match the UI URL exactly (e.g. http://localhost:8080).
DM_GOOGLE_CLIENT_ID=
NODE_ENV=development

# JWT signing secret: use a long random string (e.g. openssl rand -hex 32).
# Do NOT use your Google OAuth client secret here.
DM_JWT_SECRET=

# Browser origin(s) for CORS. For a public FQDN, set this to the exact URL users open (scheme + host, no trailing slash).
DM_FRONTEND_URL=http://localhost:8080
# Local full stack: gmai-server (Go) is the parent process. Set true so it spawns `npm run serve` in client/dungeonmaster (Vue dev server). Omit or false to run the API only and start the client separately (`npm run client`).
# DM_SPAWN_VUE_DEV=true
# Step an action back (POST /api/game-session/undo) is a development tool: it happens automatically when the Vue dev
# server is running or NODE_ENV is development. Set this only to force it on for another environment.
# DM_ALLOW_UNDO=true
# Mirror the backend log to a file. Empty leaves it on stderr only, except with DM_SPAWN_VUE_DEV, which writes
# tmp/gmai-server.log (the Vue dev server shares the terminal and drowns the backend lines). Truncated per run.
# DM_LOG_FILE=tmp/gmai-server.log
# Optional: same as DM_FRONTEND_URL when using a reverse proxy + HTTPS FQDN (also added to CORS allow list).
# DM_PUBLIC_URL=https://dungeon.example.com
# (Vue dev client: set DM_DEV_WEBSOCKET_URL or DM_PUBLIC_URL in client/dungeonmaster/.env — WSS uses explicit port 443; see client env.example.)
# Trust X-Forwarded-* from reverse proxy (nginx, Caddy, Traefik). Required for correct client IP / scheme behind TLS termination.
# DM_TRUST_PROXY=true
# Max seconds to wait for active HTTP handlers (SSE, LLM, etc.) on SIGINT/SIGTERM before forcing close. Default 5; max 120.
# DM_HTTP_SHUTDOWN_GRACE_SECONDS=5

# Reverse proxy — Nginx Proxy Manager (NPM)
# -----------------------------------------------------------------------------
# On the API host set: DM_TRUST_PROXY=true so the server trusts X-Forwarded-*.
#
# NPM UI: Hosts → Proxy Hosts → Add (or Edit) the host that serves your app (e.g. dnd.example.com).
#   • Domain Names: public FQDN
#   • Scheme: HTTP — Forward Hostname / IP: where gmai-server runs (127.0.0.1, LAN IP, or host.docker.internal from NPM container)
#   • Forward Port: API listen port (e.g. 5001)
#   • SSL certificate: enable as usual
#   • Websockets Support: optional for this app (SSE does not require it); enable if you add WebSockets later
#
# Same Proxy Host → Advanced tab → “Custom Nginx Configuration”. Paste the block below UNCOMMENTED in NPM
# (remove the leading # from each nginx line only — keep this .env file as comments if you copy from here).
# Replace YOUR_FORWARD_HOST and YOUR_FORWARD_PORT with the same Forward Hostname and Forward Port as above.
#
# --- paste into NPM (after removing # from each line) ---
# proxy_connect_timeout 600s;
# proxy_send_timeout 600s;
# proxy_read_timeout 600s;
# send_timeout 600s;
#
# location ^~ /api/game-state/events/ {
#     proxy_set_header Host $host;
#     proxy_set_header X-Real-IP $remote_addr;
#     proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
#     proxy_set_header X-Forwarded-Proto $scheme;
#     proxy_set_header X-Forwarded-Host $host;
#     proxy_pass http://YOUR_FORWARD_HOST:YOUR_FORWARD_PORT;
#     proxy_http_version 1.1;
#     proxy_set_header Connection "";
#     proxy_buffering off;
#     proxy_cache off;
#     proxy_read_timeout 86400s;
#     send_timeout 86400s;
# }
# --- end paste ---
#
# If NPM rejects the config, check the proxy host error log. Avoid duplicating a full `location /` here.
#
# Optional: per-stage LLM ceiling (default 120000 ms for non-creative stages). Does not fix a proxy that closes earlier.
# A local model's first stage can include loading the model, which alone outlives a minute.
# DM_STAGE_TIMEOUT_MS=120000
# Creative-seed stage only (Promise.race around the small JSON draw). Default 120000 ms if unset; falls back to DM_STAGE_TIMEOUT_MS when set. Use when slow/reasoning models hit stage_timeout before returning.
# DM_CREATIVE_SEED_TIMEOUT_MS=180000
# Lobby start-party-adventure: each of factions / majorNPCs / keyLocations / openingFrame uses this per-stage race (sequential). Default 120000 ms if unset. Raise if POST /api/game-session/start-party-adventure returns 500 with CAMPAIGN_STAGE_*.
# DM_LOBBY_STAGE_TIMEOUT_MS=180000
# Long LLM routes (generate-campaign-core, generate-character): default 900000 ms HTTP client timeout. Raise proxy_read_timeout too or you still get 504 from nginx/openresty.
# DM_LONG_REQUEST_SOCKET_MS=900000
# Extra CORS origins (comma-separated), e.g. alternate FQDNs or staging URLs.
# DM_CORS_ORIGINS=https://www.example.com,https://staging.example.com
# Bind address (default: all interfaces). Use 127.0.0.1 to listen on localhost only.
# DM_BIND_HOST=0.0.0.0

# Draft / lobby parties (new table from create-party, or character generated without a substantive campaign): MongoDB TTL deletes the GameState after this many minutes (single-member games only). Set to 0 to disable. Default 10080 (= 7 days).
# DM_DRAFT_PARTY_TTL_MINUTES=10080

# PC names on /generate-character: Iron Arachne MUNA (https://names.ironarachne.com/). Given + family by ancestry. When race is not "random", the server picks the name before the LLM call and injects it into the prompt so JSON + backstory match. The client may call POST /api/game-session/preview-character-name first to show that name in the form while generation runs. Set false to keep model-only names (default when unset: enabled). Optional base URL override.
# DM_USE_IRON_ARACHNE_NAMES=true
# DM_IRON_ARACHNE_NAMES_URL=https://names.ironarachne.com

# AI roles: LIGHT answers play turns, HEAVY writes the long schema-bound documents (campaign, its stages, character
# sheets, the opening adventure). Each role names its own provider, endpoint, model and key, so the local model a table
# plays on is configured once and the heavy role inherits it unless it says otherwise.
#
# DM_AI_LIGHT_PROVIDER: openai (default when unset), deepseek, gemini or lmstudio. An unknown name stops the server at
# boot instead of silently using another provider.
# DM_AI_LIGHT_MODEL: the model id, as that provider or server names it.
# DM_AI_LIGHT_URL: ONLY for lmstudio, where it is required - Ollama and LM Studio are both "lmstudio", and this is the
#   machine and port they run on (base URL, no /v1: the chat route is appended). openai, deepseek and gemini have one
#   address each, so a URL set for them stops the server instead of redirecting their traffic.
# DM_AI_LIGHT_API_KEY: optional, for a local endpoint behind a proxy or a second cloud account.
DM_AI_LIGHT_PROVIDER=lmstudio
DM_AI_LIGHT_URL=http://127.0.0.1:11434
DM_AI_LIGHT_MODEL=llama3.1:8b-instruct-q4_K_M
# DM_AI_LIGHT_API_KEY=

# HEAVY is optional: empty means authoring runs on the light tier, which is the single-provider setup. Point it at a
# cloud API (or another machine) when the small local model cannot carry the long documents. Two models on one local
# host is not worth it: it costs memory and adds a second endpoint that can be down while the first one is healthy.
# A model alone keeps the light tier's provider and host, which is how you author on a bigger model of the same machine.
# DM_AI_HEAVY_URL obeys the same rule as the light one: it exists for lmstudio and is refused for the hosted APIs.
# DM_AI_HEAVY_PROVIDER=deepseek
# DM_AI_HEAVY_URL=
# DM_AI_HEAVY_MODEL=deepseek-chat
# DM_AI_HEAVY_API_KEY=

# Per-provider keys: a key belongs to an account, not to a role, so a tier that names no key of its own uses the key of
# the provider it resolves to.
# DM_OPENAI_API_KEY=
# DM_DEEPSEEK_API_KEY=sk-...
# DM_GEMINI_API_KEY=AIza...

# The context budget the server assumes for the model it talks to. Ollama silently cuts prompts to
# OLLAMA_CONTEXT_LENGTH, so keep the two in step. DeepSeek and Gemini accept far more.
# DM_MODEL_CONTEXT_TOKENS=16384

# Development: log every LLM request/response in full to stderr (multiline llm-debug request / llm-debug out; no ellipsis). Do not enable in production.
# DM_DEBUG_LLM=true
# DM_DEBUG_CHARACTER_FLOW=true

# Vellaris map service. Campaign generation asks it for the world before writing the campaign, and renders the map
# players are shown from the same settings, so setting this is required unless the game already has an imported world.
# It also backs POST /api/game-session/import-world and POST /api/game-session/measure-travel.
# DM_VELLARIS_URL=https://vellaris.lonecesito.cl
# Map settings used to generate a campaign's world. The file holds the short document the Vellaris generator panel
# offers - dimension, world size, land shape, region count, city frequency, art pack, city icons and books - plus the
# rendering a campaign map must always have, because the generator would otherwise draw region boundaries, region
# colours, the border, shaded shores or the grid in only some of its draws. The server gives every campaign a fresh seed
# and sets `language` to the game's language, so a Spanish game gets Spanish place and region names ("Aldea de X"
# instead of "Village of X"). Point this at your own document, or send `worldSettings` with the campaign request to pin
# one specific world.
# DM_VELLARIS_SETTINGS_FILE=assets/world-settings.json
# Shared secret for the service's stored maps. When the service is configured with VELLARIS_API_TOKEN, set the same
# value here; campaign generation then asks for a stored map and keeps only its id, and the service holds the world's
# settings and image. Leave empty for a service that needs no token.
# DM_VELLARIS_TOKEN=

# Administrators, comma-separated: the Google addresses that may read the server's configuration (GET /api/admin/config)
# and the stored prompt material (GET /api/game-state/debug/{gameId}/prompts). Everyone else plays with the DM tools.
# The role is stored on the account at sign-in, so removing an address here takes effect on that account's next sign-in.
# DM_ADMIN_EMAILS=you@example.com
