# Copy to `.env` in the project root and adjust before starting the stack:
#   cp docker/.env.example .env
#   docker compose up -d
# In an existing checkout, the root `.env` already holds the app settings: add the MongoDB and port values below
# to it instead of replacing it. `.env` is git-ignored; never commit real credentials.

# --- MongoDB container ---
# Root user created in the admin database on the first start. The app's URI is assembled by compose, so use
# URL-safe characters here (a hex password from `openssl rand -hex 24` is the easy choice).
MONGO_ROOT_USER=dungeonmaster
MONGO_ROOT_PASSWORD=change-me

# Database that holds games. Use a different name to keep installs separate.
DM_MONGO_DB=dungeonmaster

# Existing Docker volume to reuse for Mongo. Find it with:
#   docker inspect <mongo-container> --format '{{range .Mounts}}{{.Name}} {{end}}'
# Leave empty to start with a fresh volume named `dungeonmaster_mongo_data`.
MONGO_DATA_VOLUME=

# --- Web app ---
# Host port the app is published on, and the image tag to run. `docker compose up -d` reads these.
DM_PORT=8080
DM_IMAGE_TAG=latest

# --- Google Sign-In ---
# Public Web OAuth client ID (Google Cloud Console → Credentials → OAuth 2.0 Client IDs, type Web).
# The SPA reads it from GET /api/meta, so it is a deploy-time value. Authorized JavaScript origins must
# match DM_FRONTEND_URL exactly (scheme + host + port).
DM_GOOGLE_CLIENT_ID=

# Long random string used only to sign app session JWTs: openssl rand -hex 32
# Do NOT use the Google OAuth client secret here.
DM_JWT_SECRET=

# Exact browser origin users open (scheme + host + port, no trailing slash). If you change DM_PORT or put the app
# behind a public hostname, set this to the URL visible in the address bar.
DM_FRONTEND_URL=http://localhost:8080
# Same value when a reverse proxy terminates HTTPS on a public FQDN.
DM_PUBLIC_URL=
# Set true when a reverse proxy forwards X-Forwarded-* headers.
DM_TRUST_PROXY=false

# --- AI provider ---
# openai (default when unset), deepseek, gemini or lmstudio.
DM_AI_PROVIDER=openai

# OpenAI
DM_OPENAI_API_KEY=
DM_OPENAI_MODEL=gpt-3.5-turbo

# DeepSeek
DM_DEEPSEEK_API_KEY=
DM_DEEPSEEK_MODEL=deepseek-chat
DM_DEEPSEEK_URL=https://api.deepseek.com

# Google Gemini through Google AI Studio
DM_GEMINI_API_KEY=
DM_GEMINI_MODEL=gemini-2.5-flash
DM_GEMINI_URL=https://generativelanguage.googleapis.com/v1beta/openai

# LM Studio: from a container, use host.docker.internal (Docker Desktop) or the host's LAN IP.
# 127.0.0.1 is the app container itself.
DM_LM_STUDIO_URL=http://host.docker.internal:1234
DM_LM_STUDIO_MODEL=

# Raise only when the selected provider supports a larger context window.
DM_MODEL_CONTEXT_TOKENS=16384

# --- Vellaris map service ---
# Required unless a game already has an imported world.
DM_VELLARIS_URL=
DM_VELLARIS_SETTINGS_FILE=assets/world-settings.json
# Same value as VELLARIS_API_TOKEN on the map service; empty when it needs no token.
DM_VELLARIS_TOKEN=

# --- Optional tuning ---
DM_DRAFT_PARTY_TTL_MINUTES=10080
DM_STAGE_TIMEOUT_MS=120000
DM_CREATIVE_SEED_TIMEOUT_MS=120000
DM_LOBBY_STAGE_TIMEOUT_MS=120000
DM_HTTP_SHUTDOWN_GRACE_SECONDS=5
DM_USE_IRON_ARACHNE_NAMES=true
DM_IRON_ARACHNE_NAMES_URL=https://names.ironarachne.com

# Development-only logging; leave off in production.
DM_DEBUG_LLM=false
DM_DEBUG_CHARACTER_FLOW=false
